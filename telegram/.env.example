# Token entregado por @BotFather
AURA_BOT_TOKEN=PEGAR_TOKEN_AQUI

# pc = simulación para desarrollo desde cualquier PC
# rpi = métricas reales de Linux/Raspberry Pi y adapter del agente
AURA_MODE=pc

# ID opcional del chat autorizado. Vacío = no restringir por chat.
# Ejemplo: AURA_ALLOWED_CHAT_ID=123456789
AURA_ALLOWED_CHAT_ID=

# Intervalo del long polling en segundos
AURA_POLL_TIMEOUT=25

# Archivos de persistencia local
AURA_DATA_DIR=data
